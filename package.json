{
  "name": "infinite-node-server",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev src/index.ts",
    "test": "jest",
    "lint": "eslint src --ext .js,.ts",
    "lint:fix": "eslint src --ext .js,.ts --fix",
    "format": "prettier --write .",
    "build": "npm run format && npm run lint && tsc",
    "seed": "ts-node src/database/seeder.ts",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write"
    ],
    "*.{json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "argon2": "^0.43.0",
    "debug": "~2.6.9",
    "dotenv": "^16.5.0",
    "koa": "^3.0.0",
    "mongoose": "^8.14.0",
    "morgan": "~1.9.1"
  },
  "devDependencies": {
    "@babel/core": "^7.21.8",
    "@babel/preset-env": "^7.21.5",
    "@babel/register": "^7.21.0",
    "@eslint/js": "^9.21.0",
    "@faker-js/faker": "^9.7.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/debug": "^4.1.12",
    "@types/jest": "^29.5.14",
    "@types/koa": "^2.15.0",
    "@types/mongoose": "^5.11.96",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.14.1",
    "@types/validator": "^13.12.3",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "babel-jest": "^29.5.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.5.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.2",
    "ts-jest": "^29.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0"
  },
  "author": {
    "name": "Maleesha Gimshan",
    "url": "https://www.github.com/maleeshagimshan98"
  }
}
