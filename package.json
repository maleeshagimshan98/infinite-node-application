{
  "name": "infinite-node-application",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch ./src/index.ts",
    "test": "jest",
    "lint": "eslint src --ext .js,.ts",
    "lint:fix": "eslint src --ext .js,.ts --fix",
    "format": "prettier --write .",
    "build": "npm run format && tsc",
    "seed": "tsx src/infrastructure/persistance/database/seeders/seeder.ts",
    "seed:clear": "tsx src/infrastructure/persistance/database/seeders/seeder.ts --clear",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write"
    ],
    "*.{json}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "argon2": "^0.43.0",
    "awilix": "^12.0.5",
    "awilix-express": "^9.0.2",
    "axios": "^1.11.0",
    "bullmq": "^5.58.4",
    "chalk": "^4.1.2",
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.2",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "http-errors": "~1.6.3",
    "mongoose": "^8.14.0",
    "morgan": "^1.10.1",
    "mysql": "^2.18.1",
    "rate-limit-redis": "^4.2.2",
    "redis": "^5.6.1",
    "socket.io": "^4.8.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.21.8",
    "@babel/preset-env": "^7.21.5",
    "@babel/register": "^7.21.0",
    "@eslint/js": "^9.21.0",
    "@faker-js/faker": "^9.7.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/debug": "^4.1.12",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^5.0.1",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^29.5.14",
    "@types/mongoose": "^5.11.96",
    "@types/morgan": "^1.9.9",
    "@types/mysql": "^2.15.27",
    "@types/node": "^22.14.1",
    "@types/validator": "^13.12.3",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "babel-jest": "^29.5.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.2.3",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.5.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.2",
    "ts-jest": "^29.3.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0"
  },
  "overrides": {
    "minimatch": "^10.2.1"
  },
  "author": {
    "name": "Maleesha Gimshan",
    "url": "https://www.github.com/maleeshagimshan98"
  }
}