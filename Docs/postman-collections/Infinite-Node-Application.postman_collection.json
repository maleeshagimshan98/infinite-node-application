{
    "info": {
        "name": "Infinite Node Application API",
        "description": "API collection for testing Infinite Node Application endpoints",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
        "_exporter_id": "0"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000",
            "type": "string"
        },
        {
            "key": "apiPrefix",
            "value": "/api/v1",
            "type": "string"
        },
        {
            "key": "authToken",
            "value": "",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "Health",
            "item": [
                {
                    "name": "Health Check",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}{{apiPrefix}}/health",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "{{apiPrefix}}",
                                "health"
                            ]
                        },
                        "description": "Comprehensive health status including service latencies"
                    },
                    "response": []
                },
                {
                    "name": "Liveness Probe",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}{{apiPrefix}}/health/live",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "{{apiPrefix}}",
                                "health",
                                "live"
                            ]
                        },
                        "description": "Quick check to see if the service process is alive (Kubernetes liveness probe)"
                    },
                    "response": []
                },
                {
                    "name": "Readiness Probe",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}{{apiPrefix}}/health/ready",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "{{apiPrefix}}",
                                "health",
                                "ready"
                            ]
                        },
                        "description": "Full check to see if the service is ready to accept traffic (Kubernetes readiness probe)"
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Register User",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 201) {",
                                    "    const jsonData = pm.response.json();",
                                    "    if (jsonData.data && jsonData.data.id) {",
                                    "        pm.environment.set('userId', jsonData.data.id);",
                                    "    }",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"SecurePassword123!\",\n  \"status\": \"pending_verification\",\n  \"cg_id\": \"default-customer-group-id\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}{{apiPrefix}}/auth/register",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "{{apiPrefix}}",
                                "auth",
                                "register"
                            ]
                        },
                        "description": "Register a new user account"
                    },
                    "response": []
                },
                {
                    "name": "Verify Email",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}{{apiPrefix}}/auth/verify-email?email=test@example.com",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "{{apiPrefix}}",
                                "auth",
                                "verify-email"
                            ],
                            "query": [
                                {
                                    "key": "email",
                                    "value": "test@example.com"
                                }
                            ]
                        },
                        "description": "Verify user email address and activate account"
                    },
                    "response": []
                },
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 201) {",
                                    "    const jsonData = pm.response.json();",
                                    "    if (jsonData.data && jsonData.data.token) {",
                                    "        pm.collectionVariables.set('authToken', jsonData.data.token);",
                                    "        pm.environment.set('authToken', jsonData.data.token);",
                                    "    }",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"SecurePassword123!\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}{{apiPrefix}}/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "{{apiPrefix}}",
                                "auth",
                                "login"
                            ]
                        },
                        "description": "Login with email and password credentials"
                    },
                    "response": []
                },
                {
                    "name": "Validate Token",
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{authToken}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}{{apiPrefix}}/auth/validate",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "{{apiPrefix}}",
                                "auth",
                                "validate"
                            ]
                        },
                        "description": "Validate authentication token and return user data"
                    },
                    "response": []
                },
                {
                    "name": "Logout",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    pm.collectionVariables.set('authToken', '');",
                                    "    pm.environment.set('authToken', '');",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{authToken}}",
                                "type": "text"
                            }
                        ],
                        "url": {
                            "raw": "{{baseUrl}}{{apiPrefix}}/auth/logout",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "{{apiPrefix}}",
                                "auth",
                                "logout"
                            ]
                        },
                        "description": "Logout user and invalidate authentication token"
                    },
                    "response": []
                }
            ]
        },
        {
            "name": "Account Recovery",
            "item": [
                {
                    "name": "Forgot Password",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "// In a real scenario, you would get the verification code from email",
                                    "// For testing, you might need to check the database or logs",
                                    "console.log('Password reset code sent to email');"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"test@example.com\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}{{apiPrefix}}/auth/forgot-password",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "{{apiPrefix}}",
                                "auth",
                                "forgot-password"
                            ]
                        },
                        "description": "Initiate password reset process - sends verification code to email"
                    },
                    "response": []
                },
                {
                    "name": "Reset Password",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"email\": \"test@example.com\",\n  \"verification_code\": \"abc123xyz\",\n  \"password\": \"NewSecurePassword123!\",\n  \"password_confirmation\": \"NewSecurePassword123!\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}{{apiPrefix}}/auth/reset-password",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "{{apiPrefix}}",
                                "auth",
                                "reset-password"
                            ]
                        },
                        "description": "Reset password using verification code received via email"
                    },
                    "response": []
                }
            ]
        }
    ]
}