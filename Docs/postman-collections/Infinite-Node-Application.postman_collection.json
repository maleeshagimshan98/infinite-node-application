                  "value": "abc123xyz"
                }
              ]
            },
            "description": "Verify user email address using the code emailed on registration (or via Resend Verification Code), and activate the account"
          },
          "response": []
        },
        {
          "name": "Resend Verification Code",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
