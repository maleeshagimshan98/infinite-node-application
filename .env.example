# Example environment configuration for infinite-node-application
# Copy this file to one of the following (and customize values):
#   - .env.development (local dev)
#   - .env.production  (container/production)
#   - .env             (fallback)

# --------------------

# NODE
NODE_ENV=development
NODE_PORT=3000

# SERVER
SSL_ENABLED=true
SSL_KEY_PATH=
SSL_CERT_PATH=

# --------------------
# CORE MIDDLEWARE
# --------------------
# Set strong secrets in real environments
COOKIE_SECRET=your-cookie-secret
SESSION_SECRET=your-session-secret
SESSION_RESAVE=
SESSION_SAVE_UNINITIALIZED=
COOKIE_DOMAIN=
COOKIE_PATH=/
COOKIE_PRIORITY=low
COOKIE_SECURE=
COOKIE_HTTP_ONLY=
COOKIE_MAX_AGE=3600000
COOKIE_PARTITIONED=

BODY_PARSER_JSON_STRICT=
BODY_PARSER_JSON_INFLATE=
BODY_PARSER_JSON_LIMIT=1mb
BODY_PARSER_URLENCODED_LIMIT=1mb

CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=
CORS_EXPOSED_HEADERS=
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

HELMET_CSP_ENABLED=true

RATE_LIMIT_WINDOW_MS=15 * 60 * 1000
RATE_LIMIT_MAX=100
RATE_LIMIT_LEGACY_HEADERS=true
RATE_LIMIT_MESSAGE=
RATE_LIMIT_STATUS_CODE=429
RATE_LIMIT_HANDLER=
RATE_LIMIT_PASS_ON_STORE_ERROR=true
RATE_LIMIT_STORE=

# --------------------
# APP
# --------------------
APP_NAME=infinite-node-application
APP_VERSION=1.0.0
APP_BASE_URL=http://localhost:3000/
API_URL_PREFIX=/api/v1/

# --------------------
# DEFAULT DRIVERS
# --------------------
CACHE_DRIVER=redis
EMAIL_DRIVER=smtp
LOGGING_DRIVER=winston
NOTIFICATION_DRIVER=inmemory
DATABASE_MAPPER_DRIVER=mongoose
QUEUE_DRIVER=bullmq
SOCKET_DRIVER=socket.io
STORAGE_DRIVER=filesystem
# --------------------
# REDIS
# --------------------
REDIS_SERVICE_OPTIONAL=true
REDIS_SERVER_HOST=localhost
REDIS_SERVER_USERNAME=
REDIS_SERVER_PASSWORD=
REDIS_SERVER_PORT=6379
REDIS_SERVER_URL=redis://localhost:6379
REDIS_TTL=3600
REDIS_SOCKET_PORT=6379
REDIS_SOCKET_HOST=localhost
REDIS_SOCKET_FAMILY=0
REDIS_SOCKET_PATH=
REDIS_SOCKET_CONNECT_TIMEOUT=5000
REDIS_SOCKET_TIMEOUT=5000
REDIS_SOCKET_NO_DELAY=
REDIS_SOCKET_KEEP_ALIVE=
REDIS_SOCKET_KEEP_ALIVE_INITIAL_DELAY=
REDIS_CONNECTION_TIMEOUT=5000

# --------------------
# CACHE
# --------------------
CACHE_SERVICE_OPTIONAL=true

# --------------------
# MONGODB
# --------------------
# If running in Docker Compose, consider using host "mongodb"
MONGODB_URI=mongodb://localhost:27017,localhost:27018/infinite-node-application?replicaSet=rs0
MONGODB_PASSWORD=
MONGODB_NAME=
MONGODB_SERVER_SELECTION_TIMEOUT_MS=15000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=45000

# --------------------
# MYSQL
# --------------------
MYSQL_DATABASE_SERVER_HOST=localhost
MYSQL_DATABASE_PORT=3306
MYSQL_DATABASE_USERNAME=root
MYSQL_DATABASE_PASSWORD=
MYSQL_DATABASE_NAME=

# --------------------
# EMAIL
# --------------------
EMAIL_SERVICE_OPTIONAL=true
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=true
EMAIL_FROM=
EMAIL_SMTP_CONNECTION_TIMEOUT=10000
EMAIL_SMTP_GREETING_TIMEOUT=10000
EMAIL_SMTP_SOCKET_TIMEOUT=30000
EMAIL_CIRCUIT_FAILURE_THRESHOLD=5
EMAIL_CIRCUIT_RESET_TIMEOUT=30000

# --------------------
# HTTP CLIENT
# --------------------
# Outbound request timeout in milliseconds
HTTP_CLIENT_TIMEOUT=5000
HTTP_CLIENT_CIRCUIT_FAILURE_THRESHOLD=5
HTTP_CLIENT_CIRCUIT_RESET_TIMEOUT=30000

# --------------------
# LOGGING - WINSTON
# --------------------
WINSTON_LOG_FILE_NAME=./logs/application-%DATE%.log
WINSTON_LOG_DATE_PATTERN=YYYY-MM-DD
WINSTON_LOG_ZIPPED_ARCHIVE=true
WINSTON_LOG_MAX_SIZE=5242880
WINSTON_LOG_MAX_FILES=5
WINSTON_LOG_LEVEL=info
WINSTON_LOG_FORMAT=json

# --------------------
# QUEUE
# --------------------
# BullMQ queue name (uses Redis). For containers, host typically "redis".
QUEUE_SERVICE_OPTIONAL=false
QUEUE_NAME=infinite-node-application_default_queue

# --------------------
# FILESYSTEM STORAGE
# --------------------
STORAGE_ROOT_PATH=

# --------------------
# NOTIFICATION
# --------------------
NOTIFICATION_SERVICE_OPTIONAL=true

# --------------------
# SOCKET
# --------------------
SOCKET_SERVICE_OPTIONAL=true

# --------------------
# JWT (RS256)
# --------------------
# Generate keys: openssl genrsa -out jwt_private.pem 2048 && openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Paste PEM content with literal \n between lines (single-line value)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Refresh token lifetime in milliseconds (default: 7 days = 604800000)
REFRESH_TOKEN_TTL_MS=604800000

# --------------------
# OBSERVABILITY - OPENTELEMETRY
# --------------------
# Standard OpenTelemetry SDK variables, read when src/app/core/telemetry/instrumentation.ts starts.
# true = the SDK is a no-op (nothing is exported). Set to false once a collector is reachable,
# e.g. `docker compose -f docker-compose.yml -f docker-compose.observability.yml up -d otel-lgtm`
OTEL_SDK_DISABLED=true
# The worker process should report as <name>-worker (set by docker-compose.observability.yml and PM2)
OTEL_SERVICE_NAME=infinite-node-application
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# otlp | console | none
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
# Push interval for metrics in milliseconds (10000 is handy locally)
OTEL_METRIC_EXPORT_INTERVAL=60000
# parentbased_always_on (default) | parentbased_traceidratio (then set OTEL_TRACES_SAMPLER_ARG, e.g. 0.1)
OTEL_TRACES_SAMPLER=parentbased_always_on