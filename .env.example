# Example environment configuration for shop-hive-connector-service
# Copy this file to one of the following (and customize values):
#   - .env.development (local dev)
#   - .env.production  (container/production)
#   - .env             (fallback)

# --------------------
# NODE
# --------------------
NODE_ENV=development
NODE_PORT=3000

# --------------------
# SERVER
# --------------------
SSL_ENABLED=true
SSL_KEY_PATH=
SSL_CERT_PATH=

# --------------------
# CORE MIDDLEWARE
# --------------------
# Set strong secrets in real environments
COOKIE_SECRET=your-cookie-secret
SESSION_SECRET=your-session-secret
SESSION_RESAVE=
SESSION_SAVE_UNINITIALIZED=
COOKIE_DOMAIN=
COOKIE_PATH=/
COOKIE_PRIORITY=low
COOKIE_SECURE=
COOKIE_HTTP_ONLY=
COOKIE_MAX_AGE=3600000
COOKIE_PARTITIONED=

BODY_PARSER_JSON_STRICT=
BODY_PARSER_JSON_INFLATE=
BODY_PARSER_JSON_LIMIT=1mb
BODY_PARSER_URLENCODED_LIMIT=1mb

CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=
CORS_EXPOSED_HEADERS=
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

HELMET_CSP_ENABLED=true

RATE_LIMIT_WINDOW_MS=15 * 60 * 1000
RATE_LIMIT_MAX=100
RATE_LIMIT_LEGACY_HEADERS=true
RATE_LIMIT_MESSAGE=
RATE_LIMIT_STATUS_CODE=429
RATE_LIMIT_HANDLER=
RATE_LIMIT_PASS_ON_STORE_ERROR=true
RATE_LIMIT_STORE=

# --------------------
# APP
# --------------------
APP_NAME=infinite-node-application
APP_VERSION=1.0.0
APP_BASE_URL=http://localhost:3000/
API_URL_PREFIX=/api/v1/

# --------------------
# DATABASE
# --------------------
DB_DRIVER=mongodb

# MySQL (only if DB_DRIVER=mysql)
MYSQL_DATABASE_SERVER_HOST=localhost
MYSQL_DATABASE_USERNAME=
MYSQL_DATABASE_PASSWORD=
MYSQL_DATABASE_NAME=

# MongoDB (only if DB_DRIVER=mongodb)
# If running in Docker Compose, consider using host "mongodb"
MONGODB_URI=mongodb://localhost:27017/infinite-node-application
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_NAME=

# --------------------
# CACHE
# --------------------
CACHE_DRIVER=redis
# If running in Docker Compose, consider using host "redis"
CACHE_SERVER_HOST=localhost
CACHE_SERVER_USERNAME=
CACHE_SERVER_PASSWORD=
CACHE_SERVER_PORT=6379
CACHE_SERVER_URL=redis://localhost:6379
CACHE_TTL=3600
CACHE_SOCKET_PORT=6379
CACHE_SOCKET_HOST=localhost
CACHE_SOCKET_FAMILY=0
CACHE_SOCKET_PATH=
CACHE_SOCKET_CONNECT_TIMEOUT=5000
CACHE_SOCKET_TIMEOUT=5000
CACHE_SOCKET_NO_DELAY=
CACHE_SOCKET_KEEP_ALIVE=
CACHE_SOCKET_KEEP_ALIVE_INITIAL_DELAY=
CONNECTION_TIMEOUT=5000

# --------------------
# QUEUE
# --------------------
# BullMQ queue name (uses Redis). For containers, host typically "redis".
QUEUE_NAME=inf_node_app_default_queue

# --------------------
# STORAGE
# --------------------
STORAGE_DRIVER=fileSystem
STORAGE_ROOT_PATH=

# --------------------
# EMAIL
# --------------------
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=true

# --------------------
# LOGGING - WINSTON
# --------------------
WINSTON_LOG_FILE_NAME=./logs/application-%DATE%.log
WINSTON_LOG_DATE_PATTERN=YYYY-MM-DD
WINSTON_LOG_ZIPPED_ARCHIVE=true
WINSTON_LOG_MAX_SIZE=5242880
WINSTON_LOG_MAX_FILES=5
WINSTON_LOG_LEVEL=info
WINSTON_LOG_FORMAT=json

# SERVICES
EXAMPLE_SERVICE_URL=http://localhost:3002
